# 環境變數範本（憲章「技術與資料限制」：所有設定由環境變數提供，不得寫死於程式碼）
#
# 複製為 .env 後填入實際值。.env 不得進入版本控管。
# 本檔案不得含有任何實際金鑰、密碼或連線字串。

# ── Supabase（必填，缺少時應用程式啟動即失敗）───────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=
# 僅供資料庫遷移與維護作業使用。不得用於處理使用者請求（research.md R-002）。
SUPABASE_SERVICE_ROLE_KEY=

# ── AI 服務（未填時 AI 功能回傳 503，核心流程不受影響）─────────────────
GEMINI_API_KEY=
# 模型 ID 不得寫死於程式碼；使用前須實測可用性（research.md R-005）
GEMINI_MODEL=

# ── SMTP（未填時通知發送標記為 FAILED，不拋出例外）─────────────────────
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ── 沙箱 ───────────────────────────────────────────────────────────────
# 留空使用 Docker 預設執行時期；設為 runsc 啟用 gVisor（research.md R-001）
SANDBOX_RUNTIME=
# 沙箱映像檔名稱前綴，實際映像檔為 <PREFIX><language>
SANDBOX_IMAGE_PREFIX=sandbox-
# 同時執行數上限（FR-046）
SANDBOX_MAX_CONCURRENCY=10

# ── 應用行為 ───────────────────────────────────────────────────────────
# 專屬連結效期天數（FR-017）
TOKEN_TTL_DAYS=7
# 單次考核試跑次數上限（FR-032）
MAX_TRIAL_RUNS=20
# 內部人員登入後的權杖效期（小時，FR-005）。與應徵者連結的 TOKEN_TTL_DAYS 無關。
SESSION_TTL_HOURS=8
# 應徵者作答頁的基底網址，用於組出完整的專屬連結。
# 正式路徑為 <站台>/candidate/assessment.html（spec 002 FR-105）。
# 舊值 <站台>/assessment.html 仍可運作——該路徑保留為轉址頁，
# 使 7 天效期內已寄出的連結不失效（FR-106）。
CANDIDATE_BASE_URL=

# ── 測試 ───────────────────────────────────────────────────────────────
# 本機 PostgreSQL 連線字串。設定後才執行 RLS 政策測試（research.md R-008）。
TEST_DATABASE_URL=
